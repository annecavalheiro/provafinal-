#include <stdio.h>

// Função que lê, soma, calcula a média e conta, tudo na mesma recursão
int processar_notas(float v[], int i, float soma, float *media) {
    // Caso base: leu os 10 alunos
    if (i == 10) {
        *media = soma / 10.0; // A soma total está pronta, calcula a média
        return 0;             // Inicia o contador de alunos acima da média
    }
    
    // 1. IDA: Lê a nota e preenche o vetor
    printf("Nota do aluno %d: ", i + 1);
    scanf("%f", &v[i]);
    
    // 2. Chama o próximo passo da recursão
    int acima = processar_notas(v, i + 1, soma + v[i], media);
    
    // 3. VOLTA: A média final já foi calculada no caso base. Agora compara.
    if (v[i] > *media) {
        acima++;
    }
    
    return acima;
}

int main() {
    float notas[10], media;
    
    // Inicia a recursão: índice 0 e soma 0.0
    int total_acima = processar_notas(notas, 0, 0.0, &media);
    
    printf("\nMédia: %.2f\nAcima da média: %d\n", media, total_acima);
    return 0;
}
